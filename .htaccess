Options -Indexes

ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
RewriteEngine On

# 阻擋直接訪問維護腳本
<FilesMatch "^(install\.php|setup_db\.php|migrate_.*\.php|seed_.*\.php|debug_.*\.php|reset_.*\.php|deploy_.*\.php|check_.*\.php)$">
  Require all denied
</FilesMatch>

# Pretty URL
RewriteRule ^store/([a-z0-9_-]+)/?$ store.php?sub=$1 [L,QSA]
RewriteRule ^category/([a-z0-9-]+)/?$ category.php?slug=$1 [L,QSA]
RewriteRule ^city/?$ city.php [L,QSA]
RewriteRule ^city/([a-z0-9-]+)/?$ city.php?slug=$1 [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]

# 舊 gomag.com.tw 店家頁 SEO 301：/{slug}.html → /store/{slug}
# 只在實體 .html 檔不存在時才 redirect（避免誤傷未來新增的真實 .html 檔）
# 用 %{HTTP_HOST} 組絕對 URL，避免 MAMP base path 干擾（staging/prod doc root 為 /）
RewriteCond %{HTTPS} =on
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([a-z0-9_-]+)\.html$ https://%{HTTP_HOST}/store/$1 [R=301,L]

RewriteCond %{HTTPS} !=on
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([a-z0-9_-]+)\.html$ http://%{HTTP_HOST}/store/$1 [R=301,L]
</IfModule>
